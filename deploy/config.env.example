# AI Gateway Budget Admin: deployment settings.
# Copy to config.env, fill in, keep it private (chmod 600; it holds secrets). Used by deploy/deploy.sh.
# Values are read by bash: quote anything with spaces or special characters, and keep JSON in single quotes.

# ---------------------------------------------------------------- Kubernetes
KUBE_CONTEXT=""                       # kubectl context; empty = current context
NAMESPACE="aigw-budget-admin"
# How users reach the app. PUBLIC_URL is the exact URL people open (no trailing slash); it decides the OIDC redirect
# URI (<PUBLIC_URL>/oauth2/callback) and whether cookies are Secure (https).
PUBLIC_URL="https://budgets.example.com"
# Exposure: "ingress" (recommended: TLS on your ingress controller), "loadbalancer", or "clusterip" (port-forward only)
EXPOSE="ingress"
INGRESS_CLASS="nginx"                 # ingress only
INGRESS_TLS_SECRET="budgets-tls"      # ingress only: existing TLS secret in NAMESPACE for PUBLIC_URL's host ("" = no TLS block)
LB_IP=""                              # loadbalancer only: fixed IP if your LB supports it (MetalLB annotation), else ""

# ---------------------------------------------------------------- Prisma AIRS AI Gateway (SCM service account)
SCM_TSG_ID="1234567890"
SCM_CLIENT_ID="budget-admin@1234567890.iam.panserviceaccount.com"
SCM_CLIENT_SECRET="change-me"
# Workspaces to show. name = display name; workspace_id = UUID; slug = workspace slug (ws-xxxxxx-xxxxxx)
DEPARTMENTS='[{"name":"Engineering","workspace_id":"00000000-0000-0000-0000-000000000000","slug":"ws-engine-000000"}]'

# ---------------------------------------------------------------- Behaviour
DEMO="false"                          # "true": synthetic sample data, no SCM service account needed (preview only)
TIER_KEY="metadata.jwt_tier"          # metadata key your tier budget policies use in their conditions
SPEND_WINDOW_HOURS="168"              # spend window for the "spend by model" numbers (168 = 7 days)
READ_ONLY="true"                      # "true": Reset hidden and refused. Set "false" to allow budget resets
TITLE_SUFFIX=""                       # e.g. " (Acme)"
APP_SUBTITLE="Department and per-user LLM budgets"
CACHE_SECONDS="30"

# ---------------------------------------------------------------- Admin sign-in (oauth2-proxy, any OIDC provider)
OIDC_ISSUER_URL="https://idp.example.com/oauth2/default"
OIDC_CLIENT_ID="aigw-budget-admin"
OIDC_CLIENT_SECRET="change-me"
OIDC_PROVIDER="oidc"                  # "oidc" (Okta, Entra ID, Ping, Auth0, ...) or "keycloak-oidc"
OIDC_EMAIL_CLAIM="email"              # Entra ID: often "preferred_username" or "upn"
OIDC_SCOPE="openid email profile"
OIDC_ALLOW_UNVERIFIED_EMAIL="false"   # "true" if your IdP omits email_verified (e.g. some Entra / Keycloak setups)
ADMIN_EMAILS="admin1@example.com,admin2@example.com"   # only these can sign in
IDP_LOGOUT_URL=""                     # optional: IdP end-session URL so Sign out also ends the IdP session
# 32-byte cookie secret. Generate once and keep it:
#   python3 -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
COOKIE_SECRET=""

# ---------------------------------------------------------------- Images (pin or mirror for air-gapped clusters)
APP_IMAGE="python:3.12-slim"
PROXY_IMAGE="quay.io/oauth2-proxy/oauth2-proxy:v7.7.1"
